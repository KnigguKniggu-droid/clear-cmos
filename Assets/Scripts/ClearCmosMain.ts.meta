  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ClearCmosMain – repair flow</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input bool recordingMode {"hint":"Recording only. On: LeafIndex and LEAF Plugin Bridge are disabled at start, so no LEAF scenario or LEAF overlay can show, and the chassis cage, table edge, and idle Monitor frame are hidden or dimmed for video. Turn it off to run tests."}'
    - '// @input float waitSeconds = 10 {"hint":"Time-lapsed wait in seconds after the fix. LEAF scenarios set this to 1.", "widget":"slider", "min":1, "max":30, "step":1}'
    - '// @input float trainingSeconds = 6 {"hint":"Time-lapsed first-boot hold in seconds. LEAF scenarios set this to 3.", "widget":"slider", "min":1, "max":30, "step":1}'
    - '// @input float screwdriverHoldSeconds = 2 {"hint":"Seconds the screwdriver holds on the pins at the fix."}'
    - '// @input float padFlashSeconds = 0.15 {"hint":"Seconds the jumper pads flash on contact. The audit value is 0.15."}'
    - '// @input float padAcceptCm = 3 {"hint":"Maximum distance in cm between the battery and the pad to accept a drop.", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input float minDragCm = 3 {"hint":"Minimum battery drag in cm from its marked edge.", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input float refusalSeconds = 2.5 {"hint":"Seconds the refusal line stays visible.", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - '// @input float proximityCm = 20 {"hint":"Distance in cm between the cursor and a no-go box at which the box starts to strengthen.", "widget":"slider", "min":5, "max":40, "step":1}'
    - '// @input string genericRefusal = "Follow the green ring first." {"hint":"Refusal line used when a part has no refusal text of its own."}'
    - '// @input string symptomLabelLine1 = "DRAM light stuck on? Pinch it." {"hint":"Opening label beside the DRAM light, first line."}'
    - '// @input string symptomLabelLine2 = "If it just started, wait. Memory training can look like this." {"hint":"Opening label beside the DRAM light, second line."}'
    - '// @input string cordLabel = "Unplug the power cord" {"hint":"Step label: power cord."}'
    - '// @input string glassLabel = "Lift the glass side panel" {"hint":"Step label: glass."}'
    - '// @input string gpuLabel = "Or lift graphics card" {"hint":"Label for the optional battery route: lift the graphics card."}'
    - '// @input string jumperLabel = "Pinch CLR_CMOS pins" {"hint":"Step label: jumper."}'
    - '// @input string batteryLabel = "Drag battery to green pad" {"hint":"Step label: battery."}'
    - '// @input string powerLabel = "Press the power button" {"hint":"Step label: power button."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject cameraObject {\"hint\":\"Camera object used to place the rig at the user's start.\"}"
    - '// @input SceneObject rig {"hint":"Rig root."}'
    - '// @input Asset.Material overlayMaterial {"hint":"Transparent unlit material cloned for rings and outlines."}'
    - '// @input SceneObject dramLed {"hint":"DRAM LED."}'
    - '// @input AssignableType_1 monitor {"hint":"Monitor screen UI."}'
    - '// @input SceneObject xRay {"hint":"X-ray group."}'
    - '// @input AssignableType_2 arrow {"hint":"Arrow controller."}'
    - '// @input AssignableType_3 nextCue {"hint":"The arrow over the current next-step target."}'
    - '// @input SceneObject batteryPad {"hint":"Battery pad."}'
    - '// @input AssignableType_4 powerCord {"hint":"PowerCord."}'
    - '// @input AssignableType_5 glass {"hint":"Glass."}'
    - '// @input AssignableType_6 gpu {"hint":"GPU."}'
    - '// @input AssignableType_7 jumper {"hint":"Jumper."}'
    - '// @input AssignableType_8 rstJumper {"hint":"RstJumper decoy: the RST pins beside CLR_CMOS."}'
    - '// @input AssignableType_9 battery {"hint":"Battery."}'
    - '// @input AssignableType_10 batteryRedPart {"hint":"BatteryRedPart decoy."}'
    - '// @input AssignableType_11 socket {"hint":"Socket decoy."}'
    - '// @input AssignableType_12 memoryStick {"hint":"MemoryStick decoy."}'
    - '// @input AssignableType_13 powerButton {"hint":"PowerButton."}'
    - '// @input AssignableType_14 symptomButton {"hint":"SymptomButton."}'
    - '// @input AssignableType_15 anchorButton {"hint":"AnchorButton."}'
    - '// @input AssignableType_16 rebuildButton {"hint":"RebuildButton."}'
    - '// @input AssignableType_17 symptomLabel {"hint":"SymptomLabel."}'
    - '// @input AssignableType_18 symptomNote {"hint":"SymptomNote: the caution sentence of the opening, in the top lane."}'
    - '// @input AssignableType_19 stepLabel {"hint":"StepLabel."}'
    - '// @input AssignableType_20 stepLabel2 {"hint":"StepLabel2, used only at the fix."}'
    - '// @input AssignableType_21 refusalLine {"hint":"RefusalLine."}'
    - '// @input AssignableType_22 waitCard {"hint":"WaitCard."}'
    - '// @ui {"widget":"group_end"}'
